# .env.example - Copy karke .env banao aur values fill karo
# DO NOT commit .env file to git!

# JWT Secret (koi bhi random string, minimum 32 characters)
JWT_SECRET=aaa_realestate_replace_this_with_your_secret_key_minimum_32_chars

# Admin Credentials
ADMIN_EMAIL=admin@aaarealestate.com
ADMIN_PASSWORD=admin123

# Server Port (optional, default: 3001)
PORT=3001

